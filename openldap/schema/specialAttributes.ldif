# Lab auxiliary schema: specialAttributes + hostAccess (multi-valued)
#
# IMPORTANT: after ldapadd, ALWAYS verify BOTH:
#   ldapsearch ... "(olcObjectClasses=*specialAttributes*)" dn
#   ldapsearch ... "(olcAttributeTypes=*hostAccess*)" dn
#
# If the OC exists but hostAccess does not, apply:
#   specialAttributes-add-hostAccess.ldif  (fix {N} with your schema index)
#
# Load (inside container, BEFORE data LDIF):
#   ldapadd -Y EXTERNAL -H ldapi:/// -f specialAttributes.ldif

dn: cn=specialattributes,cn=schema,cn=config
objectClass: olcSchemaConfig
cn: specialattributes
olcAttributeTypes: ( 1.3.6.1.4.1.99999.1.1.1 NAME 'hostAccess' DESC 'Hosts a subject may access' EQUALITY caseIgnoreMatch SUBSTR caseIgnoreSubstringsMatch SYNTAX 1.3.6.1.4.1.1466.115.121.1.15 )
olcObjectClasses: ( 1.3.6.1.4.1.99999.1.2.1 NAME 'specialAttributes' DESC 'Lab marker OC for ACL-related attrs' SUP top AUXILIARY MAY ( hostAccess ) )
